{
  "manifest_version": 3,
  "name": "Bouncer Bridge",
  "version": "1.1.37",
  "description": "Bouncer content scripts and native bridge for the Android GeckoView host.",
  "browser_specific_settings": {
    "gecko": { "id": "bouncer@imbue.com" }
  },
  "permissions": [
    "nativeMessaging",
    "geckoViewAddons"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://*.linkedin.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "world": "ISOLATED",
      "run_at": "document_start",
      "js": ["gsi_button_fix.js"]
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://*.linkedin.com/*"],
      "exclude_matches": [
        "https://x.com/i/flow/*",
        "https://twitter.com/i/flow/*",
        "https://x.com/login*",
        "https://twitter.com/login*",
        "https://x.com/signup*",
        "https://twitter.com/signup*",
        "https://x.com/account/*",
        "https://twitter.com/account/*"
      ],
      "world": "ISOLATED",
      "run_at": "document_start",
      "js": ["bridge_iso.js"]
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://*.linkedin.com/*"],
      "exclude_matches": [
        "https://x.com/i/flow/*",
        "https://twitter.com/i/flow/*",
        "https://x.com/login*",
        "https://twitter.com/login*",
        "https://x.com/signup*",
        "https://twitter.com/signup*",
        "https://x.com/account/*",
        "https://twitter.com/account/*"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "js": [
        "build_flag.js",
        "bridge_page.js",
        "ChromePolyfill.js",
        "dist/background-app.js"
      ]
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "exclude_matches": [
        "https://x.com/i/flow/*",
        "https://twitter.com/i/flow/*",
        "https://x.com/login*",
        "https://twitter.com/login*",
        "https://x.com/signup*",
        "https://twitter.com/signup*",
        "https://x.com/account/*",
        "https://twitter.com/account/*"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "js": ["adapters/twitter/fiber-extractor.js"]
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "exclude_matches": [
        "https://x.com/i/flow/*",
        "https://twitter.com/i/flow/*",
        "https://x.com/login*",
        "https://twitter.com/login*",
        "https://x.com/signup*",
        "https://twitter.com/signup*",
        "https://x.com/account/*",
        "https://twitter.com/account/*"
      ],
      "world": "MAIN",
      "run_at": "document_end",
      "js": [
        "dompurify.js",
        "dist/TwitterAdapter.js",
        "dist/content.js"
      ],
      "css": [
        "content.css",
        "adapters/twitter/twitter.css"
      ]
    },
    {
      "matches": ["https://*.linkedin.com/*"],
      "world": "MAIN",
      "run_at": "document_end",
      "js": [
        "dompurify.js",
        "dist/LinkedInAdapter.js",
        "dist/content.js"
      ],
      "css": [
        "content.css",
        "adapters/linkedin/linkedin.css"
      ]
    }
  ]
}
